# Service account keys — never commit these
*-key.json
*-sa.json
service-account*.json
gcp-key*.json
credentials.json
shoppulse-*.json

# Astro / Airflow
.bin/
.astro/
airflow_settings.yaml
logs/
# contains a machine-specific absolute path — see docker-compose.override.yml.example
docker-compose.override.yml

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
profiles.yml
# dbt/profiles/profiles.yml is env_var-only (no secrets) — safe to commit
!dbt/profiles/profiles.yml

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Env
.env
.env.*

# Personal reference notes
PROJECT_OVERVIEW.md

# OS
.DS_Store
